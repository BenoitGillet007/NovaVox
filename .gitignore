# ---------------------------------------------------------------
# NovaVox — fichiers générés/locaux à ne jamais versionner
# ---------------------------------------------------------------

# Build PyInstaller / Inno Setup
dist/
build/
Output/
*.spec

# Environnement Python
__pycache__/
*.pyc
.venv/
venv/

# Modèles téléchargés (trop volumineux pour Git — Vosk fait ~1,4 Go)
model/
piper/

# Sauvegardes automatiques et journaux
backups/
erreurs.log
crash_log.txt

# Tous les fichiers de configuration/données JSON : réglages propres à
# chaque machine (window_config, audio_config, overlay_config...),
# commandes et réglages IA personnels, version.json (régénéré tout seul
# par build_exe.bat à chaque build). Le dépôt pouvant devenir public,
# aucun .json local ne doit être partagé par défaut.
*.json
profiles/

# URL de webhook Discord (secrète, jamais versionnée)
discord_webhook.txt

# Divers éditeurs / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Fichiers de test personnels
sfs.txt
test.txt