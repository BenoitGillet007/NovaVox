dist/
build/
Output/
*.spec

# Environnement Python
__pycache__/
*.pyc
.venv/
venv/

# Modèles téléchargés (trop volumineux pour Git — Vosk fait ~1,4 Go)
model/
piper/

# Sauvegardes automatiques et journaux
backups/
erreurs.log
crash_log.txt

# Réglages et données propres à CETTE machine/cet utilisateur
